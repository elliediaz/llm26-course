{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G 게임 고객 문의 티켓",
  "description": "가상 수집형 RPG '프로젝트 루멘'의 고객 문의를 읽고 상담 티켓 JSON 하나를 만든다.",
  "type": "object",
  "properties": {
    "category": {
      "enum": [
        "버그",
        "밸런스",
        "결제",
        "계정",
        "이벤트",
        "제재",
        "기타"
      ],
      "description": "문의 분류"
    },
    "entity": {
      "type": [
        "string",
        "null"
      ],
      "description": "문의에 나온 게임 고유명(영웅·장비·이벤트·상품·콘텐츠). 없으면 null. 신고 대상 유저 닉네임은 넣지 않는다"
    },
    "patch": {
      "enum": [
        "v1.0",
        "v1.1",
        "v1.2",
        "v1.3",
        "v1.4",
        "v1.5",
        null
      ],
      "description": "관련 패치 버전(변경·버그가 생긴 버전). 없으면 null"
    },
    "is_intended": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "공지된 의도된 변경이면 true, 버그면 false, 해당 없으면 null"
    },
    "fact": {
      "type": [
        "string",
        "null"
      ],
      "description": "판단 근거가 되는 핵심 사실 한 줄. 수치 변경은 '항목 이전값→이후값' 형식. 없으면 null"
    },
    "action": {
      "enum": [
        "안내",
        "버그접수",
        "결제확인",
        "보안조치",
        "제재검토",
        "이관"
      ],
      "description": "처리 방법"
    },
    "priority": {
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "description": "우선순위(P1 가장 급함)"
    }
  },
  "required": [
    "category",
    "entity",
    "patch",
    "is_intended",
    "fact",
    "action",
    "priority"
  ],
  "additionalProperties": false
}
